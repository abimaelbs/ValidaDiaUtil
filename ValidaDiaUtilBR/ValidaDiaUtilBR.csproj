<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net6.0</TargetFrameworks>
    <!--<TargetFramework>net472</TargetFramework>-->
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>

    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>ValidaDiaUtilBR</Title>
    <Authors>Abimael.Dev</Authors>    
    <Description>Valida se uma data é dia útil no Brasil, considerando feriados nacionais e personalizados.</Description>
    <PackageReleaseNotes>Setup</PackageReleaseNotes>
    <PackageId>ValidaDiaUtilBR</PackageId>
    <PackageTags>datas,data util,feriado,feriados</PackageTags>
    <Version>1.0.2</Version>
    
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net6.0'">
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
